{
  "manifest_version": 3,
  "name": "Xero Keyboard Shortcuts",
  "version": "1.0",
  "description": "Keyboard shortcuts for Xero's bank account reconciliation interface",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["https://go.xero.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
} 